# Copy this file to .env for local development.
# Do not commit real secrets.

# Required for live NVIDIA NIM topic/question generation.
NVIDIA_API_KEY=your_nvidia_nim_key_here

# Optional. Defaults to NVIDIA's current Nemotron 3.5 hosted model.
NIM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Optional local server port. Railway sets PORT automatically.
PORT=4173

# Optional Vite build setting: public HTTPS origin of the deployed Node API.
# Set GitHub repository variable QUESTAR_API_BASE_URL for the Android web build.
# VITE_API_BASE_URL=https://your-questar-api.example.com
# Online topic generation can use a separate serverless endpoint without enabling shared accounts.
# VITE_NIM_API_BASE_URL=https://connors.dev

# Backend CORS allowlist. Use exact origins, separated by commas; no paths or wildcards.
# For the app hosted at connors.dev, set this on the API service:
# CORS_ALLOWED_ORIGINS=https://connors.dev

# Set true only when Railway's trusted proxy sets X-Real-IP for every request.
# TRUST_PROXY_HEADERS=false

# Optional production database. Railway PostgreSQL provides DATABASE_URL.
# DATABASE_URL=postgresql://user:password@host:5432/database
# DATABASE_SSL=true
